# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Same origin as the app: nginx proxies /api to the backend, so the refresh
# cookie is a first-party cookie and needs no CORS exemption.
VITE_API_URL=http://localhost:3000/api

# Sepolia testnet — must match the backend's CHAIN_ID, or SIWE sign-in is rejected.
VITE_CHAIN_ID=11155111
VITE_CHAIN_NAME=Sepolia

# Filled in by `make deploy-contracts`.
VITE_NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TIP_JAR_ADDRESS=0xC51D2D96bCbB4E70b0F7a5a4Fc06B234931C6567
VITE_ARTIFACTS_ADDRESS=0x14F1373dff11e915d8AcAAB505D6b3F427901B0f
VITE_MARKETPLACE_ADDRESS=0x9DCc60CfDd8ad78F9557D2bB83e62afeA0Fb8994
VITE_REFERRALS_ADDRESS=0xCEa9ba1d0fd011C7F6D472572b4489483E41Ba85
VITE_RPC_URL=https://sepolia.drpc.org
