{
  "name": "@ethers-web3/backend",
  "version": "2.0.0",
  "description": "Express API with SIWE wallet auth, JWT sessions and ERC-721 reads",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/index.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "env-cmd npx sequelize-cli db:seed:all",
    "migrate": "env-cmd npx sequelize-cli db:migrate",
    "down-migrate": "env-cmd npx sequelize-cli db:migrate:undo:all"
  },
  "author": "Kirill Nefodov",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "argon2": "0.41.1",
    "bullmq": "5.41.7",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "ethers": "6.13.5",
    "express": "5.0.1",
    "express-rate-limit": "7.5.0",
    "helmet": "8.0.0",
    "joi": "17.13.3",
    "jsonwebtoken": "9.0.2",
    "ms": "2.1.3",
    "nodemailer": "6.10.0",
    "pg": "8.13.3",
    "pg-hstore": "2.3.4",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "redis": "4.7.0",
    "sequelize": "6.37.5",
    "siwe": "3.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.8",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.9",
    "@types/node": "22.13.7",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.2",
    "env-cmd": "10.1.0",
    "eslint": "9.21.0",
    "nodemon": "3.1.9",
    "pino-pretty": "13.0.0",
    "prettier": "3.5.2",
    "sequelize-cli": "6.6.2",
    "supertest": "7.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.25.0",
    "vitest": "3.0.7"
  }
}
