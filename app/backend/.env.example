# Every variable below is validated at boot (src/config/env.ts).
# A missing or malformed value stops the process with a readable error rather
# than surfacing as NaN token lifetimes at 3am.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

FRONTEND_URL=http://localhost:3000

DB_HOST=db
DB_PORT=5432
DB_NAME=ethers_web3
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Must be different from each other and at least 32 chars.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Sepolia testnet. Any public RPC works; no API key needed for the demo.
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CHAIN_ID=11155111
# Uniswap V3 Positions NFT on Sepolia: a real, verified ERC721Enumerable
# contract, so the gallery works with no setup. Swap in any collection you own.
NFT_CONTRACT_ADDRESS=0x1238536071E1c677A632429e3655c799b22cDA52
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Password-reset mail. Defaults point at the Mailpit container in docker-compose,
# which catches every message at http://localhost:8025 instead of sending it.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@ethers-web3.dev
