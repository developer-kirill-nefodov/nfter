# Every variable below is validated at boot (src/config/env.ts).
# A missing or malformed value stops the process with a readable error rather
# than surfacing as NaN token lifetimes at 3am.

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

FRONTEND_URL=http://localhost:3000

DB_HOST=db
DB_PORT=5432
DB_NAME=nfter
DB_USERNAME=postgres
DB_PASSWORD=postgres

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Must be different from each other and at least 32 chars.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Sepolia testnet. Any public RPC works; no API key needed for the demo.
# Must serve historical eth_getLogs: publicnode refuses anything older than
# ~128 blocks, which the chain indexer cannot work with.
RPC_URL=https://sepolia.drpc.org
CHAIN_ID=11155111
# Uniswap V3 Positions NFT on Sepolia: a real, verified ERC721Enumerable
# contract, so the gallery works with no setup. Swap in any collection you own.
NFT_CONTRACT_ADDRESS=0x1238536071E1c677A632429e3655c799b22cDA52
IPFS_GATEWAY=https://ipfs.io/ipfs/

# Filled in by `make deploy-contracts` (app/contracts/deployments/sepolia.json).
ARTIFACTS_ADDRESS=0x14F1373dff11e915d8AcAAB505D6b3F427901B0f
MARKETPLACE_ADDRESS=0x9DCc60CfDd8ad78F9557D2bB83e62afeA0Fb8994
TIP_JAR_ADDRESS=0xC51D2D96bCbB4E70b0F7a5a4Fc06B234931C6567
# The block the contracts landed in. Public RPC nodes cap how far back a log
# query may reach, so the tip indexer starts here rather than at genesis.
CONTRACTS_FROM_BLOCK=0

# Password-reset mail. Defaults point at the Mailpit container in docker-compose,
# which catches every message at http://localhost:8025 instead of sending it.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@nfter.dev
REFERRALS_ADDRESS=0xCEa9ba1d0fd011C7F6D472572b4489483E41Ba85
